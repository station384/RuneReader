<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- Avalonia uses Program.Main as the entrypoint -->
    <ApplicationIcon>Icons\RuneReader_Icon.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>

    <!-- Avalonia -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

	  <!-- Enable ReadyToRun compilation -->

	  <SignAssembly>False</SignAssembly>
	  <DelaySign>False</DelaySign>
	  <Platforms>x64</Platforms>

  </PropertyGroup>


  <PropertyGroup Condition="'$(OS)'=='Windows_NT'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)'!='Windows_NT'">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
		<SignManifests>true</SignManifests>
		<ManifestCertificateThumbprint>06cb8534ee63d4af060dc0d1b3d8830b4e44d170</ManifestCertificateThumbprint>
		<Title>Rune Reader</Title>
		<Version>$(VersionPrefix)</Version>
		<AssemblyVersion></AssemblyVersion>
		<AssemblyOriginatorKeyFile></AssemblyOriginatorKeyFile>
		<!-- Optionally, remove these if not needed:
  <ManifestCertificateFile>path\to\YourCertificate.pfx</ManifestCertificateFile>
  <ManifestCertificatePassword>YourPasswordHere</ManifestCertificatePassword>
  -->
	</PropertyGroup>
	
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>False</Optimize>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
	
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Optimize>False</Optimize>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>True</Optimize>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Optimize>True</Optimize>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Label="Avalonia">
    <AvaloniaXamlReportImportance>Low</AvaloniaXamlReportImportance>
    <AvaloniaXamlIlDebuggerLaunch>False</AvaloniaXamlIlDebuggerLaunch>
    <AvaloniaXamlVerboseExceptions>False</AvaloniaXamlVerboseExceptions>
    <Copyright>2026 Michael Sutton</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260213" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260213" />

    <!-- Runtime/native bindings -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" Condition="'$(OS)'=='Windows_NT'" />
    <PackageReference Include="OpenCvSharp4.unofficial.runtime.linux-x64" Version="4.10.0.20241108" />

    <!-- Screen capture -->
    <PackageReference Include="ScreenCapture.NET.DX11" Version="3.0.0" Condition="'$(OS)'=='Windows_NT'" />
    <PackageReference Include="ScreenCapture.NET.X11" Version="3.0.0" Condition="'$(OS)'!='Windows_NT'" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.2" />
    <PackageReference Include="Tmds.DBus" Version="0.90.3" />

    <PackageReference Include="ZXing.Net" Version="0.16.11" />

    <!-- Avalonia UI -->
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
    <None Remove="Classes\Platform\Linux\Wayland\PipeWire.old\**" />
    <None Remove="RuneReader_v4.zip" />
    <None Remove="RuneReader_v3.zip" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <Compile Remove="Classes\Platform\Linux\Wayland\PipeWire.old\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="captures\holder.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>


  <ItemGroup>
    <Folder Include="Classes\NativeBitmap\" />
    <Folder Include="Classes\Platform\Linux\X11\" />
    <Folder Include="Properties\PublishProfiles\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Remove="Classes\Platform\Linux\Wayland\PipeWire.old\**" />
  </ItemGroup>

  <!--<ItemGroup>
    <AvaloniaXaml Include="**\*.axaml" />
  </ItemGroup>-->

  <ItemGroup>
    <Compile Remove="Classes\ImageExtension.cs" />
    <Compile Remove="Classes\NativeBitmap\ImageHelpers.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Icons\RuneReader_Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Remove="Icons\RuneReader_Icon.ico" />
    <AvaloniaResource Remove="Classes\Platform\Linux\Wayland\PipeWire.old\**" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="Classes\Platform\Linux\Wayland\PipeWire.old\**" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Remove="Classes\Platform\Linux\Wayland\PipeWire.old\**" />
  </ItemGroup>

</Project>
